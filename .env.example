BACKEND_PORT=3001
BACKEND_HOST=127.0.0.1
DATABASE_URL=postgresql://im_growth_audit:change-me@127.0.0.1:55432/im_growth_audit

ADMIN_USER=admin
ADMIN_PASSWORD=guclu-bir-sifre
SESSION_SECRET=uzun-rastgele-bir-anahtar
INGEST_TOKEN=uzun-rastgele-bir-veri-aktarma-anahtari

KV_REST_API_URL=
KV_REST_API_TOKEN=

# E-posta (Gönderim). 465 → SSL, 587 → STARTTLS. Gönderen adres boşsa SMTP_USER kullanılır.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME="Istanbul Marketing"
# Günlük gönderim limiti (yeni alan adında düşük başlayıp kademeli artırın)
SEND_DAILY_LIMIT=25
# MAIL_DRY_RUN=1 → gerçek gönderim yapmadan akışı dener (yalnızca geliştirme)

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PSI_KEY=

# Radar, varsayılan olarak anahtarsız OpenStreetMap/Nominatim aramasını kullanır.

# Growth Audit™
# AI analisti (öznel metrikler ve yönetici özeti). Tanımlı değilse bu metrikler "Bilinmiyor" kalır.
ANTHROPIC_API_KEY=
# AUDIT_AI_MODEL=claude-haiku-5-5
# AUDIT_AI_DISABLED=1
# Maliyet takibi için USD / 1M token (varsayılan claude-haiku-5-5 fiyatı, 100K token altı istem)
# AUDIT_AI_PRICE_IN=0.1
# AUDIT_AI_PRICE_OUT=0.5
# PSI_KEY (yukarıda) Google Lighthouse ölçümleri için gereklidir; anahtarsız kota çok düşüktür.
# Arka plan işçisi: AUDIT_WORKER=0 bu sunucuda işçiyi kapatır (çok sunuculu kurulum).
# AUDIT_WORKER=1
# AUDIT_CONCURRENCY=2
# AUDIT_TIMEOUT_MS=240000
# AUDIT_MAX_PAGES=6
# Müşteri rapor bağlantılarının mutlak adresi (ör. https://customer.istanbul.marketing). Boşsa isteğin geldiği adres kullanılır.
# PUBLIC_REPORT_BASE_URL=

# AI Growth Manager™ (müşteri portalı)
# Portal oturum imzası (boşsa SESSION_SECRET'tan türetilir; üretimde ayrı tanımlayın)
PORTAL_SESSION_SECRET=
# Entegrasyon belirteçlerinin şifrelenmesi: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=
# Google OAuth (Google Cloud Console → OAuth istemcisi; yönlendirme: https://<alan-adı>/oauth/google/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Google Ads API (developer token; MCC hesabı varsa login customer id)
GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v22
# Portal davet bağlantılarının mutlak adresi (boşsa isteğin geldiği adres)
# PUBLIC_PORTAL_BASE_URL=
# Zamanlanmış işler: GM_WORKER=0 kapatır; GM_INTERVAL_MS (varsayılan 10 dk)

# Çalışma ortamı ve güvenlik (Milestone 4)
# NODE_ENV=production iken zorunlu ayarlar eksik/zayıfsa uygulama başlamaz (SESSION_SECRET ≥32, ADMIN_PASSWORD ≥12 karakter).
NODE_ENV=development
# Güvenilen vekil sayısı. Next.js X-Forwarded-For'a kendi kaydını eklemediği için hem 'Next.js → backend' hem
# 'Nginx/Caddy/Cloudflare → Next.js → backend' kurulumunda doğru değer 1'dir. Önde IP'yi ekleyen bir ters vekil ŞARTTIR;
# Next.js doğrudan internete açılırsa istemci IP'si taklit edilebilir ve hız sınırları atlatılabilir.
TRUST_PROXY_HOPS=1
# Çerezli yazma isteklerinde izin verilen ek kökenler (virgülle). Aynı alan adı her zaman izinlidir.
# ALLOWED_ORIGINS=https://customer.istanbul.marketing
# Veri saklama (gün, en az 7): RETENTION_SCREENSHOTS_DAYS=180 RETENTION_METRICS_DAYS=400 RETENTION_SYNCS_DAYS=90
# RETENTION_REPORT_LINKS_DAYS=180 RETENTION_DISCARDED_DRAFTS_DAYS=90 RETENTION_CLOSED_INSIGHTS_DAYS=180 RETENTION_BRIEFS_DAYS=400
# docker compose kurulumunda veritabanı parolası
# POSTGRES_PASSWORD=

# Kartla ödeme (iyzico). Anahtarlar iyzico panelinde Ayarlar → API anahtarları bölümündedir.
# Test: IYZICO_BASE_URL=https://sandbox-api.iyzipay.com (sandbox-merchant.iyzipay.com hesabının anahtarlarıyla)
# Canlı: IYZICO_BASE_URL=https://api.iyzipay.com (onaylı üye iş yeri hesabının anahtarlarıyla)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Taksit seçenekleri (virgülle; 1 = tek çekim). Taksit vade farkı iyzico panelinden yönetilir.
# IYZICO_INSTALLMENTS=1,2,3,6
# Müşteri kimlik no. gerektiren hesaplar için varsayılan değer (çoğu hesapta değiştirmeniz gerekmez)
# IYZICO_DEFAULT_IDENTITY=11111111111
# Havale/EFT bilgisi: ödeme linkinde ve portalda kart seçeneğinin yanında gösterilir (boşsa gösterilmez)
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_IBAN=
# Ödeme linklerinin mutlak adresi (boşsa PUBLIC_PORTAL_BASE_URL, o da boşsa isteğin geldiği adres)
# PUBLIC_PAYMENT_BASE_URL=
# Yalnızca yerel geliştirme: sahte ödeme sağlayıcısı (üretimde başlamaz)
# PAYMENT_PROVIDER=mock

# Ücretsiz dijital analiz (herkese açık form: POST /api/public/audit)
# İzin verilen kökenler (CORS, virgülle). Boşsa tarayıcıdan çapraz köken istek kabul edilmez.
# PUBLIC_AUDIT_ORIGINS=https://istanbul.marketing,http://localhost:3000
# Yeni gelen talep bildirimi (SMTP ayarları gerekir). Telegram için TELEGRAM_BOT_TOKEN/CHAT_ID yeterlidir.
# LEAD_NOTIFY_EMAIL=
